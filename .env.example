# Both values below are PUBLIC by design (Supabase's anon key is meant to be
# shipped to the browser — real security comes from the Row Level Security
# policies in supabase/schema.sql, not from hiding this key). Safe to commit
# a filled-in .env.production later; never commit the *service role* key
# anywhere in this frontend project if one gets added for a future backend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# LEAVE THIS UNSET IN PRODUCTION.
#
# The discovery and PRD endpoints now run as Supabase Edge Functions, which
# is what keeps the Gemini/Groq keys in Supabase Secrets and out of the
# browser, and what puts them behind Supabase Auth. Leaving this empty is
# what selects that path.
#
# Setting it routes both endpoints back to the legacy Express backend in
# server/ (`npm run server`) instead — an escape hatch for local work
# against that server, and for reverting the migration without a code
# change. Setting it in Netlify would send every visitor's browser to the
# old, unauthenticated backend.
# VITE_AREEP_API_URL=http://localhost:3002

# Public origin of the deployed site, with no trailing slash
# (e.g. https://areeb.sa). Read at BUILD time, not runtime.
#
# Everything a crawler or a social scraper reads depends on it: canonical
# URLs, og:url, og:image, and whether sitemap.xml is generated at all. If
# it is unset the build deliberately omits those tags and skips the
# sitemap rather than baking in a guessed domain — a canonical pointing at
# the wrong host is far more damaging than a missing one. The build prints
# a warning when this happens.
VITE_SITE_URL=

# Contact address shown on the privacy and terms pages. Left unset, those
# pages render without a mailto link rather than inventing an address.
VITE_CONTACT_EMAIL=

# Optional. Collector endpoint for the vendor-free analytics in
# src/lib/analytics.js — a self-hosted Plausible/Umami event URL, or your
# own API route. Unset (the default) means no events are sent anywhere and
# no third-party script is loaded, which is why the app needs no cookie
# consent banner. Setting it turns the existing track() calls into
# fire-and-forget beacons; it never adds cookies or cross-site identifiers.
VITE_ANALYTICS_URL=
